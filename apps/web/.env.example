# Copy to .env.local for local dev (it is gitignored).
#
# Base URL of the CatRanger FastAPI control server (`catranger serve`).
# The console's REST calls, the MJPEG <img>, and the control WebSocket all
# derive from this. If unset, the client defaults to http://localhost:8080.
#
# For phone / LAN access, set this to the HOST machine's LAN IP (not localhost,
# which on a phone means the phone itself), e.g. http://192.168.1.42:8080 — and
# add that origin to `cors_origins` in configs/web.yaml.
NEXT_PUBLIC_API_BASE=http://localhost:8080
